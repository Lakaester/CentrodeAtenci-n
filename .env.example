# ============================================================
#  VARIABLES DE ENTORNO - Plataforma BI Soporte Especializado
#  Copia este archivo como ".env" y rellena tus valores.
# ============================================================

# --- Base de datos PostgreSQL ---
POSTGRES_USER=bi_user
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=restaurant_bi
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Cadena de conexión que usa el backend (Prisma).
# Si usas Docker Compose, POSTGRES_HOST debe ser "postgres" (nombre del servicio).
DATABASE_URL="postgresql://bi_user:cambia_esta_clave@localhost:5432/restaurant_bi?schema=public"

# --- Backend ---
BACKEND_PORT=4000
NODE_ENV=development
# Origen permitido para el frontend (CORS)
CORS_ORIGIN=http://localhost:5173

# --- Frontend ---
# URL del backend que consume el frontend.
VITE_API_URL=/api
