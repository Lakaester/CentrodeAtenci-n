DATABASE_URL="postgresql://bi_user:cambia_esta_clave@localhost:5432/restaurant_bi?schema=public"
BACKEND_PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Zendesk (opcional — solo lectura por ahora)
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
# Importante: la variable debe llamarse ZENDESK_API_TOKEN (no ZENDESK_TOKEN)
ZENDESK_API_TOKEN=

# Localbi (Historia Clínica de Restaurant.pe)
# LOCALBI_MODE: "public" (sin token) | "private" (requiere LOCALBI_TOKEN)
# BASE_URL real (variante pública /public/rest/localbi/*): microservices.restaurant.pe/backendrestaurantpe
# El responsable del servicio confirmó que la integración debe usar la variante PUBLIC.
LOCALBI_BASE_URL=https://microservices.restaurant.pe/backendrestaurantpe
LOCALBI_MODE=public
LOCALBI_TOKEN=

# Autenticación — administrador inicial (bootstrap idempotente)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
